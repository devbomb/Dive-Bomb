[sub_resource type="BoxShape3D" id="BoxShape3D_xadyu"]
size = Vector3(1, 0.734, 0.782)

[sub_resource type="GDScript" id="GDScript_u6aji"]
script/source = "extends Node

@export var x_noise: Noise
@export var z_noise: Noise

const _shake_freq: float = 5
const _shake_scale: float = 20
const _shake_duration: float = 0.6
const _kick_cooldown_duration: float = 0.75

var _shake_timer: float = 0
var _kick_cooldown_timer: float = 0

func _process(delta: float) -> void:
	_shake_timer = move_toward(_shake_timer, 0, delta)
	_kick_cooldown_timer = move_toward(_kick_cooldown_timer, 0, delta)

	var scale = _shake_scale * (_shake_timer / _shake_duration)

	var model: Node3D = get_parent()
	model.rotation_degrees.x = x_noise.get_noise_1d(_shake_timer * _shake_freq) * scale
	model.rotation_degrees.z = z_noise.get_noise_1d(_shake_timer * _shake_freq) * scale

func on_bonk() -> void:
	_shake_timer = _shake_duration

func on_kick() -> void:
	if _kick_cooldown_timer <= 0:
		_kick_cooldown_timer = _kick_cooldown_duration
		_shake_timer = _shake_duration
"

