[gd_resource type="Environment" format=3 uid="uid://dk0eyoi3afr5p"]

[sub_resource type="Shader" id="Shader_1j2jw"]
code = "shader_type sky;

uniform sampler3D noise_texture : filter_linear, source_color, hint_default_black;
uniform float time_scale = 0.01;

vec3 get_noise_color(sampler3D noise, vec2 sky_coords)
{
	vec4 color = texture(noise, vec3(sky_coords.x, sky_coords.y, TIME * time_scale));
	return color.rgb;
}

void sky() 
{
	COLOR = get_noise_color(noise_texture, SKY_COORDS);
}
"

