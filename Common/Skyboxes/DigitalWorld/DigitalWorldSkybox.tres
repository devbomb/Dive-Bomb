[gd_resource type="Environment" format=3 uid="uid://dk0eyoi3afr5p"]

[sub_resource type="Shader" id="Shader_1j2jw"]
code = "shader_type sky;

uniform sampler3D noise_texture : filter_linear, source_color, hint_default_black;
uniform float time_scale = 0.01;

uniform vec3 grid_color : source_color;

uniform vec3 void_color : source_color;
uniform float void_radius = 0.0;

vec3 get_noise_color(sampler3D noise, vec2 sky_coords)
{
	vec4 color = texture(noise, vec3(sky_coords.x, sky_coords.y, TIME * time_scale));
	return color.rgb;
}

vec3 apply_grid(vec3 color, vec2 sky_coords)
{
	const float thickness = 0.001;
	float line_y = mod(TIME * 0.25, 1.0);

	if (abs(sky_coords.y - line_y) < thickness)
		color = grid_color;
	return color;
}

vec3 apply_void(vec3 color, vec2 sky_coords)
{
	float t = 2.0 * abs(sky_coords.y - 0.5);
	t += void_radius;
	t = min(t, 1.0);
	return mix(color, void_color, t);
}

void sky()
{
	COLOR = get_noise_color(noise_texture, SKY_COORDS);
	COLOR = apply_grid(COLOR, SKY_COORDS);
	COLOR = apply_void(COLOR, SKY_COORDS);
}
"

