[gd_resource type="Environment" format=3 uid="uid://dk0eyoi3afr5p"]

[sub_resource type="Shader" id="Shader_1j2jw"]
code = "shader_type sky;

uniform sampler3D red_noise : filter_linear, source_color, hint_default_black;
uniform sampler3D green_noise : filter_linear, source_color, hint_default_black;
uniform sampler3D blue_noise : filter_linear, source_color, hint_default_black;

float get_brightness(sampler3D noise, vec2 sky_coords)
{
	const float time_scale = 0.1;
	vec4 color = texture(noise, vec3(sky_coords.x, sky_coords.y, TIME * time_scale));
	return length(color.rgb);
}

void sky() 
{
	vec3 unnormalized = vec3(
		get_brightness(red_noise, SKY_COORDS),
		get_brightness(green_noise, SKY_COORDS),
		get_brightness(blue_noise, SKY_COORDS)
	);
	
	COLOR = 0.5 * normalize(unnormalized);
}
"

